{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "types": ["vite/client", "node"],

    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "*.ts"]
  // 注意：这里**不**声明 references。
  // 根工程已经用 "*.ts" 覆盖了 vite.config.ts，若再把 tsconfig.node.json 声明为引用工程，
  // 同一文件会同时属于两个工程，tsc 会报 TS6305（输出文件未从源文件构建）。
  // tsconfig.node.json 作为一个独立工程存在，供 IDE / 单独的 Node 侧检查使用。
}
